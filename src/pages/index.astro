---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import heroImage from "../assets/images/hero-home.avif";
import { courseMeta } from "../course-config";
import { sessionLabels, siteConfig } from "../site-config";
---

<ContentLayout
  title={`${courseMeta.code}: ${courseMeta.title}`}
  description={courseMeta.description}
  heroImage={heroImage}
  heroImageAlt="Two interleaved sine-wave strands, gold and black on warm cream, crossed by short rungs like a schematic helix, in a two-ink risograph print"
  {...siteConfig}
>
  <ul class="course-tags" aria-label="Course tags">
    {courseMeta.tags.map((tag) => <li>{tag}</li>)}
  </ul>

  <h2>What you will do</h2>
  <p>
    You will spend the semester handling real protein structures: fetching them
    from the Protein Data Bank, rendering and interrogating them in PyMOL,
    comparing how different experimental methods see the same molecule, and
    running and judging a computational structure prediction against the
    experimental original. In the second half of semester you choose one
    structure and take it apart in depth — its fold, its binding site, and what
    its shape tells you about what it does — and hand in that analysis as your
    final project.
  </p>

  <h2>Who it is for</h2>
  <p>
    Anyone comfortable with first-year biology and willing to learn a new piece
    of software (PyMOL) from scratch. No prior structural biology or
    programming experience is assumed; you should already be able to read a
    protein sequence and know roughly what an amino acid is.
  </p>

  <h2>Where to go next</h2>
  <CardGrid columns={2}>
    <Card title={sessionLabels.plural} href="/sessions/">
      <p>The weekly schedule and what happens in each teaching session.</p>
    </Card>
    <Card title="Assessment" href="/assessments/">
      <p>What is marked, what it is worth, and when it is due.</p>
    </Card>
    <Card title="People" href="/people/">
      <p>Who teaches the course and how to reach them.</p>
    </Card>
  </CardGrid>
</ContentLayout>

<style>
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0 2rem;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: var(--at-text-secondary);
    background: var(--at-bg-alt);
    font-size: 0.9rem;
  }
</style>
